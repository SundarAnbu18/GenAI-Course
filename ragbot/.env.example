# Copy to ragbot/.env and fill in. .env is gitignored — never commit real keys.
# Anything set in the real environment (systemd, your shell) wins over this file.

# --- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Comma separated. Required once DEBUG=False.
DJANGO_ALLOWED_HOSTS=
# Needed for the HTML form over HTTPS, e.g. https://ragbot.1-2-3-4.nip.io
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# --- Embedded widget ------------------------------------------------------
# Shared secret the widget sends as X-Api-Key. Empty disables the check.
WIDGET_API_KEY=
# Sites allowed to call the API from the browser, e.g. https://sundaranbu.com
CORS_ALLOWED_ORIGINS=

# --- Retrieval and generation --------------------------------------------
RAG_CHAT_MODEL=claude-sonnet-5
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_MAX_TOKENS=1024
# Load the model and index at boot instead of on the first request. Set to 1
# under gunicorn; leave off locally so management commands stay fast.
RAG_EAGER_LOAD=0
# Override where documents are read from and the index is written to.
# RAG_DOCUMENTS_DIR=
# RAG_INDEX_DIR=
