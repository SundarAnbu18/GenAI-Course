# Copy to ragbot/.env and fill in. .env is gitignored — never commit real keys.
# Anything set in the real environment (systemd, your shell) wins over this file.

# --- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Comma separated. Required once DEBUG=False.
DJANGO_ALLOWED_HOSTS=
# Needed for the HTML form over HTTPS, e.g. https://ragbot.1-2-3-4.nip.io
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# --- Embedded widget ------------------------------------------------------
# Shared secret the widget sends as X-Api-Key. Empty disables the check.
WIDGET_API_KEY=
# Sites allowed to call the API from the browser, e.g. https://sundaranbu.com
CORS_ALLOWED_ORIGINS=

# --- Retrieval and generation --------------------------------------------
RAG_CHAT_MODEL=claude-sonnet-5
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_MAX_TOKENS=1024
# Sampling temperature. LEAVE UNSET on claude-sonnet-5, claude-opus-5,
# claude-opus-4-8 and claude-fable-5 — they reject it with
# "400 `temperature` is deprecated for this model". Works on
# claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-6 and older.
# RAG_TEMPERATURE=0.2

# Conversation memory. Empty keeps history in process memory, which is fine for
# `manage.py runserver` and WRONG under gunicorn — its workers are separate
# processes, so follow-ups would land on a worker that has never seen the
# conversation. Set a DSN in production.
# RAG_HISTORY_DSN=sqlite:////home/YOUR_USER/GenAI-Course/ragbot/var/history.sqlite3
# How many past exchanges are replayed to the model each turn.
RAG_HISTORY_TURNS=6
# Load the model and index at boot instead of on the first request. Set to 1
# under gunicorn; leave off locally so management commands stay fast.
RAG_EAGER_LOAD=0
# Override where documents are read from and the index is written to.
# RAG_DOCUMENTS_DIR=
# RAG_INDEX_DIR=
